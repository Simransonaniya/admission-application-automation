          "values": [
            {
              "fieldLabel": "Full Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone",
              "requiredField": true
            },
            {
              "fieldLabel": "Date of Birth",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "Program",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "School - Primary"
                  },
                  {
                    "option": "School - Secondary"
                  },
                  {
                    "option": "School - Higher Secondary"
                  },
                  {
                    "option": "College - Undergraduate"
                  },
                  {
                    "option": "College - Postgraduate"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Previous Marks Percentage",
              "fieldType": "number",
              "placeholder": "e.g. 78",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "admission-application",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you! Your application has been received."
            }
          }
        }
      },
