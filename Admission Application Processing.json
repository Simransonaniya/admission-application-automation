      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "applicant_name",
              "value": "={{ $('Application Form').item.json['Full Name'] }}",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "email",
              "value": "={{ $('Application Form').item.json['Email'] }}",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "phone",
              "value": "={{ String($('Application Form').item.json['Phone']) }}",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "date_of_birth",
              "value": "={{ $('Application Form').item.json['Date of Birth'] }}",
              "type": "string"
            },
            {
              "id": "c5",
              "name": "age",
              "value": "={{ Math.floor($now.diff(DateTime.fromISO($('Application Form').item.json['Date of Birth']), 'years').years) }}",
              "type": "number"
            },
            {
              "id": "c6",
              "name": "program",
              "value": "={{ $('Application Form').item.json['Program'] }}",
              "type": "string"
            },
            {
              "id": "c7",
              "name": "previous_marks",
              "value": "={{ Number($('Application Form').item.json['Previous Marks Percentage']) }}",
              "type": "number"
            },
            {
              "id": "c8",
              "name": "eligibility_status",
              "value": "={{ (Number($('Application Form').item.json['Previous Marks Percentage']) >= $json.min_marks && Math.floor($now.diff(DateTime.fromISO($('Application Form').item.json['Date of Birth']), 'years').years) >= $json.min_age && Math.floor($now.diff(DateTime.fromISO($('Application Form').item.json['Date of Birth']), 'years').years) <= $json.max_age) ? \"Eligible\" : \"Not Eligible\" }}",
              "type": "string"
            },
            {
              "id": "c9",
              "name": "eligibility_reason",
              "value": "={{ (() => { const age = Math.floor($now.diff(DateTime.fromISO($('Application Form').item.json['Date of Birth']), 'years').years); const marks = Number($('Application Form').item.json['Previous Marks Percentage']); const r = []; if (marks < $json.min_marks) r.push(\"Marks \" + marks + \"% below minimum \" + $json.min_marks + \"%\"); if (age < $json.min_age) r.push(\"Age \" + age + \" below minimum \" + $json.min_age); if (age > $json.max_age) r.push(\"Age \" + age + \" above maximum \" + $json.max_age); return r.length ? r.join(\"; \") : \"Meets all eligibility criteria\"; })() }}",
              "type": "string"
            },
            {
              "id": "c10",
              "name": "submitted_at",
              "value": "={{ $('Application Form').item.json.submittedAt }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
